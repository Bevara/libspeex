{
    "name": "libspeex",
    "description": "Speex decoder",
    "filters":["speexdec"],
    "help": "This filter decodes Speex speech streams using libspeex. It consumes the GF_CODECID_SPEEX pid produced by oggdmx from a .spx file.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libspeex.accessor",
    "filter_source":{
        "speexdec" : "dec_speex.c"
    },
    "extension":{
      "spx" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "Format": [
        "Speex"
    ],
    "patents": {
        "status": "royalty-free",
        "note": "Speex",
        "checked": "2026-10-16"
    }
}
